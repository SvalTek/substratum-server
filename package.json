    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.44.1",
    "@igloczek/astro-bun-adapter": "^1.3.0",
    "@nanostores/vue": "^1.1.0",
    "@svaltek/substratum": "github:SvalTek/substratum#main",
    "astro": "^7.4.13",
    "nanostores": "^1.5.5",
