---
import Layout from './Layout.astro';
interface Props { title: string; }
const { title } = Astro.props;
const currentPath = Astro.url.pathname;
const groups = [
  {
    heading: 'WORKSPACE',
    items: [
      { href: '/', label: 'Overview' },
      { href: '/atlas', label: 'Atlas' },
      { href: '/content', label: 'Content Explorer' },
      { href: '/cells', label: 'Cells & Attachments' },
      { href: '/query', label: 'Query Workbench' },
      { href: '/events', label: 'Events & Activity' },
    ],
  },
  {
    heading: 'OPERATIONS',
    items: [
      { href: '/plugins', label: 'Plugins' },
      { href: '/clients', label: 'Clients & Credentials' },
      { href: '/storage', label: 'Storage' },
      { href: '/diagnostics', label: 'Diagnostics' },
      { href: '/api-explorer', label: 'API Explorer' },
      { href: '/settings', label: 'Settings' },
    ],
  },
];
---

<Layout title={`${title} · Substratum Server`}>
  <div class="dashboard-frame">
    <aside class="app-sidebar">
      <a class="app-brand" href="/" aria-label="Substratum Server dashboard">
        <span class="app-mark" aria-hidden="true"><i></i><i></i><i></i></span>
        <span><strong>Substratum</strong><small>Server</small></span>
      </a>
      <nav aria-label="Dashboard sections">
        {groups.map(group => (
          <div class="nav-group">
            <span class="nav-heading">{group.heading}</span>
            {group.items.map(({ href, label }) => {
              const active = currentPath === href || (href !== '/' && currentPath.startsWith(`${href}/`));
              return <a class:list={['nav-link', { active }]} href={href} aria-current={active ? 'page' : undefined}>{label}</a>;
            })}
          </div>
        ))}
      </nav>
      <button class="app-signout" type="button" id="dashboard-signout">Sign out</button>
    </aside>
    <div class="dashboard-main"><slot /></div>
  </div>
</Layout>

<script>
  document.querySelector('#dashboard-signout')?.addEventListener('click', async event => {
    const button = event.currentTarget as HTMLButtonElement;
    button.disabled = true;
    try {
      const response = await fetch('/api/auth/logout', { method: 'POST' });
      if (response.ok || response.status === 401) location.assign('/login');
      else button.textContent = 'Retry sign out';
    } catch {
      button.textContent = 'Retry sign out';
    } finally {
      button.disabled = false;
    }
  });
</script>

<style>
  .app-mark { position: relative; flex: 0 0 30px; height: 32px; }
  .app-mark i { position: absolute; inset: 0 0 auto; height: 18px; background: #528fff; clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%); }
  .app-mark i:nth-child(1) { top: 14px; }
  .app-mark i:nth-child(2) { top: 7px; background: #655bd4; }
  .app-mark i:nth-child(3) { background: #a08bff; }
  .nav-link:focus-visible, .app-brand:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .app-signout {
    width: 100%;
    margin-top: auto;
    padding: 8px 10px;
    color: var(--text-secondary);
    background: var(--bg-elevated);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    font-size: 12px;
    font-weight: 600;
  }
  .app-signout:hover { border-color: var(--accent); color: var(--text-primary); }
  @media (max-width: 760px) {
    .app-sidebar { display: flex; flex-direction: row; flex-wrap: wrap; align-items: center; gap: 10px; height: auto; }
    .app-brand { margin: 0; }
    .app-sidebar nav { order: 1; width: 100%; display: flex; flex-wrap: wrap; gap: 8px; }
    .nav-group { display: flex; flex-wrap: wrap; gap: 4px; margin: 0; }
    .nav-heading { display: none; }
    .app-signout { width: auto; margin: 0 0 0 auto; }
  }
</style>
