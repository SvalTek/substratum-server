# Bind locally; place Cloudflare Tunnel or another reverse proxy in front.
HOST=127.0.0.1
PORT=4321

# The directory is created automatically. Relative paths are from this package folder.
DATABASE_PATH=./data/substratum.sqlite
PLUGINS_DIR=./plugins
SUBSTRATUM_BITS=16

# Replace both values before starting. Keep this file private and out of version control.
DASHBOARD_PASSWORD=replace-with-a-long-random-password
MANAGEMENT_TOKEN=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=43200

# Set true when the browser reaches this server over HTTPS, including through a tunnel.
COOKIE_SECURE=false
# Optional public dashboard origin when a reverse proxy uses a different origin internally.
# PUBLIC_ORIGIN=https://atlas.example.com
